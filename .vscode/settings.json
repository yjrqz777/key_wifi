{
    "idf.adapterTargetName": "esp32s3",
    "idf.openOcdConfigs": [
        "board/esp32s3-bridge.cfg"
    ],
    "idf.flashType": "UART",
    "idf.port": "/dev/ttyACM0",
    "files.associations": {
        "wifi.h": "c",
        "dap_config.h": "c",
        "esp_vfs_fat.h": "c",
        "tusb_cdc_acm.h": "c",
        "esp_log.h": "c",
        "stddef.h": "c",
        "array": "c",
        "string": "c",
        "string_view": "c",
        "usbd_hid.h": "c",
        "chry_ringbuffer.h": "c"
    },
    "idf.pythonInstallPath": "/usr/bin/python3",
    "files.exclude": {
            "**/.git": false
        },
    "search.exclude": {
    "managed_components": false
    // "./node_modules": false
    }

}